# Local Docker and frontend
POSTGRES_DB=pageindex
POSTGRES_USER=pageindex
POSTGRES_PASSWORD=
APP_PUBLIC_URL=http://localhost:3000
HTTP_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Users set their own PageIndex key, chat provider key, and model in Account settings.
AUTH_REQUIRED=true
AUTH_ALLOW_SIGNUP=true
SECURE_COOKIES=false
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# Configure the sign-in and registration methods you want to offer.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cache, limits, and chat budgets
REDIS_URL=
REDIS_MAXMEMORY=64mb
REDIS_MEMORY_LIMIT=160m
PREVIEW_CACHE_TTL_SECONDS=300
MAX_UPLOAD_SIZE_MB=100
MAX_BATCH_UPLOAD_SIZE_MB=200
REQUESTS_PER_MINUTE=120
PROVIDER_REQUESTS_PER_DAY=100
CHAT_TOKENS_PER_DAY=150000
CHAT_HISTORY_TURNS=8
CHAT_HISTORY_MAX_BYTES=16000
CHAT_HISTORY_DEFAULT_TOKENS=4000
CHAT_HISTORY_TOKEN_BUDGETS={}
CHAT_SUMMARY_TURNS=4
CHAT_RETRIEVAL_DOCUMENTS=3
CHAT_RETRIEVAL_PAGES=5
CHAT_RETRIEVAL_TOKENS=3500
CHAT_OUTPUT_TOKENS=8192
CHAT_MAX_TURNS=12

# Optional single-user mode. Set AUTH_REQUIRED=false above to use these.
# PAGEINDEX_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# CHAT_MODEL=deepseek/deepseek-chat
# CHAT_ALLOWED_MODELS=[]
